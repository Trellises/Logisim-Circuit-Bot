# Copy this file to .env (which git ignores) and fill in your key.
# Get a free key at https://aistudio.google.com/apikey
# Never rename it to VITE_GEMINI_API_KEY -- VITE_ variables are bundled into
# the public JavaScript that every visitor downloads.
GEMINI_API_KEY=

# Optional: override the Gemini model (check AI Studio for current names).
# GEMINI_MODEL=gemini-2.5-flash
